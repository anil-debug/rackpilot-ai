# Copy to .env and adjust for local use:
#   cp .env.example .env
#
# Access modes:
#   RACKPILOT_PUBLISH_HOST=127.0.0.1  — localhost only; use SSH/Cursor port forward
#   RACKPILOT_PUBLISH_HOST=0.0.0.0    — listen on all interfaces; use http://<host-ip>:3000
#
# When using 0.0.0.0, set Grafana's external URL (do not put your IP in docker-compose.yml):
#   GRAFANA_ROOT_URL=http://<host-ip>:3000
#
# If UFW is active, allow ports from your LAN before expecting laptop access:
#   sudo ufw allow from <your-laptop-subnet> to any port 3000,8080,9090 proto tcp

RACKPILOT_PUBLISH_HOST=127.0.0.1
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# Grafana admin (change before any non-local exposure)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=rackpilot-dev

# Optional simulator overrides (passed to gpu-simulator container)
RACKPILOT_GPU_COUNT=4
RACKPILOT_GPU_MODEL=NVIDIA H100 80GB
RACKPILOT_TICK_MS=2000
RACKPILOT_SIM_SEED=42

# BMC simulator (container :8081, host :8082 by default)
RACKPILOT_BMC_TICK_MS=2000
RACKPILOT_BMC_SIM_SEED=42
RACKPILOT_BMC_SERVER_MODEL=SYS-210P-FakeSim
# dynamic (default) or static (official DMTF public-rackmount1 fixtures)
RACKPILOT_BMC_MODE=dynamic
# RACKPILOT_BMC_FIXTURE_ROOT=testdata/redfish/dmtf/public-rackmount1

# Incident correlation engine (host port 8083)
RACKPILOT_INCIDENT_LISTEN=:8083
RACKPILOT_PROMETHEUS_URL=http://prometheus:9090
RACKPILOT_INCIDENT_POLL_MS=15000