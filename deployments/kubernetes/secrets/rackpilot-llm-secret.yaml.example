# Copy to rackpilot-llm-secret.yaml, set base64 data, apply manually — never commit real keys.
#   kubectl create secret generic rackpilot-llm -n rackpilot \
#     --from-literal=RACKPILOT_LLM_API_KEY=sk-... --dry-run=client -o yaml | kubectl apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: rackpilot-llm
  namespace: rackpilot
  labels:
    app.kubernetes.io/part-of: rackpilot
    rackpilot.io/app-tier: rackpilot-core
type: Opaque
stringData:
  RACKPILOT_LLM_API_KEY: ""