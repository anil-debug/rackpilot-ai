  "links": [],
  "liveNow": false,
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false },
        "content": "# RackPilot — Kubernetes (kind `rackpilot-kind`)\n\nCluster metrics via **kube-state-metrics** and **cAdvisor** (API proxy). Synthetic GPU/BMC dashboards are unchanged.",
        "mode": "markdown"
      },
      "title": "Overview",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "Not Ready", "color": "red" }, "1": { "text": "Ready", "color": "green" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 3 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "kube_node_status_condition{cluster=\"rackpilot-kind\",condition=\"Ready\",status=\"true\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "Node readiness",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "stacking": { "mode": "normal" } }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 3 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (phase) (kube_pod_status_phase{cluster=\"rackpilot-kind\",namespace=\"rackpilot\"})",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "title": "Pods by phase (namespace rackpilot)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 3 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{cluster=\"rackpilot-kind\",namespace=\"rackpilot\"}",
          "legendFormat": "desired {{deployment}}",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_available{cluster=\"rackpilot-kind\",namespace=\"rackpilot\"}",
          "legendFormat": "available {{deployment}}",
          "refId": "B"
        }
      ],
      "title": "Deployment desired vs available",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (pod) (rate(kube_pod_container_status_restarts_total{cluster=\"rackpilot-kind\",namespace=\"rackpilot\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Pod restart rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 11 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{cluster=\"rackpilot-kind\",namespace=\"rackpilot\",phase=\"Pending\"}) or vector(0)",
          "legendFormat": "pending",
          "refId": "A"
        }
      ],
      "title": "Pending pods",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{cluster=\"rackpilot-kind\",namespace=\"rackpilot\",container!=\"\",image!=\"\"}[5m]))",
          "legendFormat": "{{pod}}/{{container}}",
          "refId": "A"
        }
      ],
      "title": "Container CPU usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (pod, container) (container_memory_working_set_bytes{cluster=\"rackpilot-kind\",namespace=\"rackpilot\",container!=\"\",image!=\"\"})",
          "legendFormat": "{{pod}}/{{container}}",
          "refId": "A"
        }
      ],
      "title": "Container memory (working set)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 26 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (pod, container) (rate(container_cpu_cfs_throttled_seconds_total{cluster=\"rackpilot-kind\",namespace=\"rackpilot\",container!=\"\",image!=\"\"}[5m]))",
          "legendFormat": "{{pod}}/{{container}}",
          "refId": "A"
        }
      ],
      "title": "Container CPU throttling",
      "type": "timeseries"
    }
  ],
